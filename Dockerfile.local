# syntax=docker/dockerfile:1
FROM node:24.21.0-alpine AS frontendbuilder
WORKDIR /build
ENV PUPPETEER_SKIP_DOWNLOAD=true CYPRESS_INSTALL_BINARY=0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN npm install --global corepack && corepack enable && pnpm install --frozen-lockfile
COPY frontend/ ./
RUN printf '{"VERSION":"local"}\n' > src/version.json && pnpm build

FROM golang:1.27.3-bookworm AS apibuilder
WORKDIR /build
RUN go install github.com/magefile/mage@v1.17.2
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=frontendbuilder /build/dist ./frontend/dist
ENV CGO_ENABLED=1 RELEASE_VERSION=local
RUN mage build:build

FROM debian:bookworm-slim
RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates tzdata curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 vikunja \
    && useradd --uid 1000 --gid 1000 --no-create-home vikunja \
    && mkdir -p /app/vikunja /data/files \
    && chown -R 1000:1000 /app/vikunja /data
WORKDIR /app/vikunja
COPY --from=apibuilder /build/vikunja /app/vikunja/vikunja
ENV VIKUNJA_SERVICE_ROOTPATH=/app/vikunja/ \
    VIKUNJA_DATABASE_TYPE=sqlite \
    VIKUNJA_DATABASE_PATH=/data/vikunja.db \
    VIKUNJA_FILES_BASEPATH=/data/files
USER 1000:1000
EXPOSE 3456
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:3456/health || exit 1
ENTRYPOINT ["/app/vikunja/vikunja"]
